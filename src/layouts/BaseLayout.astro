---
import '../styles/tokens.css';
import StructuredData from '../components/seo/StructuredData.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title = 'Temaky Sushi — Sushi Monterrey desde 1999',
  description = 'El mejor sushi de Monterrey desde 1999. Rollos clásicos y signature, Combo Clásico desde $139. Plaza Villa Obispado, Lun–Sáb 12–22 h.',
  ogImage = '/og.jpg',
  canonicalURL = Astro.url.href,
  noindex = false,
} = Astro.props;

const site = 'https://temakysushi.mx';
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Temaky Sushi" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Preload LCP element (navbar logo) with explicit high priority -->
    <link rel="preload" as="image" href="/images/logo/logo-temaky-sm.webp" fetchpriority="high" />

    <!-- Fonts: preconnect + async load to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Open+Sauce+Sans:wght@500;600;700&family=Oswald:wght@600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Open+Sauce+Sans:wght@500;600;700&family=Oswald:wght@600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Open+Sauce+Sans:wght@500;600;700&family=Oswald:wght@600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!--
      Google Ads · cuenta 118-217-4303 — etiqueta AW-18358666123.
      `is:inline` es obligatorio: sin él Astro convierte el script en type="module", los módulos ES
      tienen scope propio y `window.gtag` dejaría de existir. El snippet oficial usa `async`, no
      `defer`; no cambiar.
    -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18358666123"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'AW-18358666123');

      /*
        La etiqueta de la acción de conversión "Clic a WhatsApp" vive SOLO aquí. Mientras `label`
        esté vacía, temakyConv() es un no-op: el tag base mide igual y ningún clic dispara una
        conversión a medias. Cuando Google Ads la entregue, es esta única línea y un push.
      */
      window.TEMAKY_AW = { id: 'AW-18358666123', label: '' };

      window.temakyConv = function (params) {
        var conf = window.TEMAKY_AW;
        if (!conf || !conf.label || typeof window.gtag !== 'function') return;
        var payload = { send_to: conf.id + '/' + conf.label };
        for (var k in params) { if (Object.prototype.hasOwnProperty.call(params, k)) payload[k] = params[k]; }
        window.gtag('event', 'conversion', payload);
      };
    </script>
    <script>
      import { initWaTracking } from '../lib/wa-tracking';
      initWaTracking();
    </script>

    <!-- Structured Data -->
    <StructuredData />
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido</a>
    <slot />
  </body>
</html>
