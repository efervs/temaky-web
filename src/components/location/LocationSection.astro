---
---
<section class="bg-black py-[80px] px-6 md:px-[8%]" id="ubic">
  <div class="max-w-[1180px] mx-auto">

    <!-- Header fuera del grid para evitar overflow -->
    <div class="mb-10 md:mb-14 text-center max-w-[760px] mx-auto">
      <p class="text-[.78rem] font-semibold tracking-[.02em] text-white/60 mb-3">
        Dónde encontrarnos
      </p>
      <h2 class="font-display font-bold leading-[.92] uppercase text-center">
        <span class="text-white block text-[clamp(2rem,4.2vw,3.4rem)]">Nos vemos</span>
        <span class="text-[#B8102E] block text-[clamp(2rem,4.2vw,3.4rem)]">en Obispado.</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 max-[820px]:grid-cols-1 gap-9 items-start">

      <!-- Left card -->
      <div>
        <div class="bg-white/[.04] border border-white/[.07] rounded-[14px] p-5 md:p-[26px]">
          <!-- Address -->
          <div class="flex items-center gap-2 text-[.78rem] font-semibold tracking-[.01em] text-white/60 mb-[6px]">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
            Dirección
          </div>
          <span class="font-display text-[1.02rem] uppercase block mb-[2px]">Plaza Villa Obispado</span>
          <span class="text-[.84rem] text-white/55 leading-[1.5]">
            Francisco Garza Sada 2940A · Piso 2, Local 204 · Nuevo Obispado · Monterrey, N.L.
          </span>
          <a
            href="https://maps.app.goo.gl/gZdvYsTJmWGkcaNL6"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center min-h-[44px] text-rojo text-[.78rem] no-underline mt-[9px] hover:underline"
          >Abrir en Google Maps →</a>

          <div class="h-px bg-white/[.07] my-3 md:my-4"></div>

          <!-- Hours -->
          <div class="flex items-center gap-2 text-[.78rem] font-semibold tracking-[.01em] text-white/60 mb-[6px]">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            Horario
          </div>
          <span class="font-['Cormorant_Garamond'] italic text-[1.4rem] md:text-[1.65rem] block leading-none">12:00 – 22:00 hrs</span>
          <span class="text-[.75rem] text-white/55 mt-[2px] block">Lunes a Sábado · 12:00–22:00</span>

          <div class="h-px bg-white/[.07] my-3 md:my-4"></div>

          <!-- WhatsApp CTA -->
          <a
            href="https://wa.me/528127474440?text=Hola!%20Quiero%20hacer%20un%20pedido"
            target="_blank"
            rel="noopener"
            class="flex items-center justify-center gap-[9px] bg-[#25D366] text-[#0a2e1a] no-underline px-3 py-3 rounded-[8px] text-[.88rem] font-semibold mt-[14px] transition-colors hover:bg-[#1eae56] min-h-[44px]"
            style="color: #0a2e1a"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Pedir · +52 81 2747-4440
          </a>
        </div>
      </div>

      <!-- Right: Mapa con lazy load real on-demand -->
      <div
        id="map-container"
        class="relative rounded-[14px] overflow-hidden h-[420px] max-[820px]:h-[280px] border border-white/[.07] bg-[#111]"
        data-map-src="https://maps.google.com/maps?q=Temaky+Sushi,+Francisco+Garza+Sada+2940,+Nuevo+Obispado,+Monterrey,+NL,+Mexico&t=&z=16&ie=UTF8&iwloc=&output=embed"
      >
        <!-- Placeholder estático (CSS, sin descarga) -->
        <div class="map-placeholder" aria-hidden="true">
          <div class="map-grid"></div>
          <div class="map-roads"></div>
          <div class="map-pin">
            <svg width="40" height="48" viewBox="0 0 24 28" fill="none" aria-hidden="true">
              <path d="M12 0C6 0 1 5 1 11c0 8 11 17 11 17s11-9 11-17C23 5 18 0 12 0z" fill="#B8102E" stroke="#fff" stroke-width="1.5"/>
              <circle cx="12" cy="11" r="4" fill="#fff"/>
            </svg>
          </div>
        </div>

        <!-- Botón de carga del iframe interactivo -->
        <button
          type="button"
          class="map-load-btn"
          data-load-map
          aria-label="Cargar mapa interactivo de Google Maps"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          Cargar mapa interactivo
        </button>
      </div>

    </div>
  </div>
</section>

<style>
  /* Placeholder visual mientras no se cargue el iframe pesado */
  .map-placeholder {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 40%, rgba(184, 16, 46, 0.10) 0%, transparent 55%),
      linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
  }
  .map-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .map-roads {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(95deg, transparent 30%, rgba(255,255,255,0.06) 30%, rgba(255,255,255,0.06) 31%, transparent 31%),
      linear-gradient(168deg, transparent 55%, rgba(255,255,255,0.05) 55%, rgba(255,255,255,0.05) 56.2%, transparent 56.2%),
      linear-gradient(5deg, transparent 70%, rgba(255,255,255,0.04) 70%, rgba(255,255,255,0.04) 70.8%, transparent 70.8%);
  }
  .map-pin {
    position: absolute;
    left: 50%;
    top: 48%;
    transform: translate(-50%, -100%);
    filter: drop-shadow(0 6px 12px rgba(0,0,0,0.5));
    animation: pin-pop 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes pin-pop {
    from { opacity: 0; transform: translate(-50%, -80%) scale(0.7); }
    to   { opacity: 1; transform: translate(-50%, -100%) scale(1); }
  }

  .map-load-btn {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: #B8102E;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-family: var(--sans);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .map-load-btn:hover { background: #8B0D22; transform: translateX(-50%) translateY(-1px); }
  .map-load-btn:active { transform: translateX(-50%) translateY(0); }
  .map-load-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
</style>

<script>
  const mapContainer = document.getElementById('map-container');
  const loadBtn = document.querySelector<HTMLButtonElement>('[data-load-map]');

  if (mapContainer && loadBtn) {
    loadBtn.addEventListener('click', () => {
      const src = mapContainer.dataset.mapSrc;
      if (!src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.width = '100%';
      iframe.height = '100%';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.title = 'Temaky Sushi en Google Maps';
      iframe.className = 'block border-0 rounded-[14px] absolute inset-0 w-full h-full';
      iframe.setAttribute('aria-label', 'Mapa interactivo de Temaky Sushi en Plaza Villa Obispado');
      mapContainer.innerHTML = '';
      mapContainer.appendChild(iframe);
    }, { once: true });
  }
</script>
