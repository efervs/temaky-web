---
import { MENU, CATS, CAT_LBL, ORDERED_CATS, BUNDLE_CATS } from '../../data/menu';
import ProductCard from './ProductCard.astro';

const bundleSet = new Set<string>(BUNDLE_CATS as readonly string[]);
const groups = ORDERED_CATS.map(cat => ({
  cat,
  label: CAT_LBL[cat] ?? cat,
  promo: bundleSet.has(cat)
    ? (cat.startsWith('sig') ? '2×$229' : '2×$199')
    : null,
  items: MENU.filter(i => i.cat === cat),
}));
---

<div
  id="menu-overlay"
  class="menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Menú Temaky Sushi"
  aria-hidden="true"
  hidden
>
  <header class="m-hdr">
    <h2 class="m-title">Menu</h2>
    <div class="m-search">
      <svg class="si" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <input
        id="menu-search"
        type="search"
        placeholder="Buscar rollo, platillo…"
        aria-label="Buscar en el menú"
        autocomplete="off"
      />
    </div>
    <button id="cart-mini" class="cart-mini" type="button" aria-label="Ver pedido" hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <span id="cart-mini-count">0</span>
      <span class="cart-mini-sep" aria-hidden="true">·</span>
      <span id="cart-mini-total">$0</span>
    </button>
    <span class="m-hdr-sep" aria-hidden="true"></span>
    <button class="m-x" id="menu-close" aria-label="Cerrar menú" title="Cerrar menú" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </header>

  <nav class="m-cats" id="menu-cats" aria-label="Categorías">
    <button
      class="chip chip-all on"
      data-cat="all"
      type="button"
      aria-pressed="true"
    >Todo</button>
    <div class="m-cats-scroll" id="menu-cats-scroll">
      {CATS.filter(c => c.id !== 'all').map(c => (
        <button
          class="chip"
          data-cat={c.id}
          type="button"
          aria-pressed="false"
        >{c.lbl}</button>
      ))}
    </div>
  </nav>

  <main class="m-body" id="menu-body">
    {groups.map(g => (
      <section class="cg" data-cat-group={g.cat}>
        <div class="cg-hdr">
          <span class="cg-title">{g.label}</span>
          <span class="cg-rule"></span>
          {g.promo ? <span class="cg-promo">Promo {g.promo}</span> : <span class="cg-count">{String(g.items.length).padStart(2, '0')}</span>}
        </div>
        <div class="grid">
          {g.items.map(item => <ProductCard item={item} />)}
        </div>
      </section>
    ))}
    <div class="menu-empty" id="menu-no-res" role="status" hidden>
      <span class="menu-empty-ico" aria-hidden="true">🔍</span>
      <p class="menu-empty-msg">No encontramos "<strong id="menu-empty-q"></strong>".</p>
      <p class="menu-empty-sugg">
        Intenta con:
        <button class="menu-empty-tag" type="button" data-suggest="rollo">rollo</button>
        <button class="menu-empty-tag" type="button" data-suggest="combo">combo</button>
        <button class="menu-empty-tag" type="button" data-suggest="gyoza">gyoza</button>
      </p>
    </div>
    <span
      id="menu-sr-live"
      role="status"
      aria-live="polite"
      aria-atomic="true"
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0"
    ></span>
  </main>
</div>

<style>
  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--negro);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
  }
  .menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .menu-overlay[hidden] {
    display: none;
  }

  .m-hdr {
    position: sticky;
    top: 0;
    z-index: 4;
    height: 60px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    background: rgba(0,0,0,0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--g06);
  }
  .m-title {
    font-family: var(--display);
    font-size: 1.25rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
    flex-shrink: 0;
    font-weight: 700;
    margin: 0;
  }
  .m-search {
    flex: 1;
    position: relative;
    max-width: 420px;
  }
  .m-search .si {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,0.4);
    pointer-events: none;
    width: 16px;
    height: 16px;
  }
  .m-search input {
    width: 100%;
    height: 40px;
    background: var(--g06);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0 14px 0 38px;
    font-size: .88rem;
    color: #fff;
    transition: background .2s ease, border-color .2s ease;
    font-family: var(--sans);
  }
  .m-search input::placeholder { color: rgba(255,255,255,0.4); }
  .m-search input:focus {
    background: var(--g10);
    border-color: var(--g10);
    outline: none;
  }
  .m-search input:focus-visible {
    outline: 2px solid rgba(184,16,46,0.8);
    outline-offset: -2px;
  }
  .cart-mini {
    display: none;
    align-items: center;
    gap: 8px;
    background: var(--rojo);
    color: #fff;
    border: 0;
    padding: 8px 14px;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease;
  }
  .cart-mini.show { display: inline-flex; }
  .cart-mini:hover { background: var(--rojo-dark); }
  .cart-mini:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .cart-mini-sep { opacity: 0.5; }

  .m-hdr-sep {
    width: 1px;
    height: 22px;
    background: var(--g10);
    flex-shrink: 0;
    margin: 0 4px;
  }
  .m-x {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--g15);
    display: grid;
    place-items: center;
    color: #fff;
    cursor: pointer;
    transition: background .2s ease, border-color .2s ease;
  }
  .m-x:hover { background: var(--g10); border-color: var(--g40); }
  .m-x:focus-visible { outline: 2px solid var(--rojo); outline-offset: 2px; }
  .m-x svg { width: 14px; height: 14px; stroke: #fff; stroke-width: 2; fill: none; }

  .m-cats {
    position: sticky;
    top: 60px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    flex-shrink: 0;
    background: rgba(0,0,0,0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--g04);
  }
  .m-cats-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    flex: 1;
    min-width: 0;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  .m-cats-scroll::-webkit-scrollbar { display: none; }
  .chip {
    flex-shrink: 0;
    min-height: 36px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    background: var(--g06);
    color: var(--g55);
    font-size: .82rem;
    font-weight: 500;
    letter-spacing: .01em;
    white-space: nowrap;
    border: 0;
    cursor: pointer;
    font-family: var(--sans);
    transition: background .15s ease, color .15s ease;
  }
  .chip:hover { color: #fff; background: var(--g10); }
  .chip.on { background: var(--rojo); color: #fff; }
  .chip:focus-visible { outline: 2px solid var(--rojo); outline-offset: 2px; }
  .chip-all {
    flex-shrink: 0;
    margin-right: 4px;
    border: 1px solid var(--g15);
    background: rgba(0,0,0,0.85);
    box-shadow: 4px 0 12px rgba(0,0,0,0.5);
    position: relative;
    z-index: 1;
  }
  .chip-all.on {
    background: var(--rojo);
    border-color: var(--rojo);
  }

  .m-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px 120px;
    -webkit-overflow-scrolling: touch;
  }

  .cg { margin-bottom: 8px; }
  .cg[hidden] { display: none; }
  .cg-hdr {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
  }
  .cg-title {
    font-family: var(--display);
    font-size: .82rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    font-weight: 700;
  }
  .cg-rule {
    flex: 1;
    height: 1px;
    background: var(--g06);
  }
  .cg-count {
    font-size: .72rem;
    color: rgba(255,255,255,0.3);
    letter-spacing: .05em;
  }
  .cg-promo {
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #1a0a00;
    background: var(--amarillo);
    padding: 3px 8px;
    border-radius: 999px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-bottom: 26px;
  }
  :global(.pcard[hidden]) { display: none; }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 10px; }
  }
  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(4, 1fr); gap: 12px; }
  }
  @media (min-width: 1024px) {
    .m-cats {
      flex-wrap: wrap;
      overflow-x: visible;
      row-gap: 8px;
    }
  }
  @media (min-width: 1200px) {
    .grid { grid-template-columns: repeat(5, 1fr); gap: 12px; }
    .m-body { padding: 24px 28px 140px; }
    .m-hdr { padding: 0 28px; }
    .m-cats { padding: 14px 28px; }
  }
  @media (min-width: 1440px) {
    .grid { grid-template-columns: repeat(6, 1fr); gap: 14px; }
  }

  .menu-empty {
    padding: 60px 20px;
    text-align: center;
    color: rgba(255,255,255,0.65);
    font-size: .92rem;
    font-family: var(--sans);
  }
  .menu-empty-ico {
    display: block;
    font-size: 2.4rem;
    margin-bottom: 14px;
    opacity: .8;
  }
  .menu-empty-msg {
    margin: 0 0 12px;
    color: rgba(255,255,255,0.85);
  }
  .menu-empty-msg strong {
    color: var(--rojo);
    font-weight: 600;
  }
  .menu-empty-sugg {
    margin: 0;
    color: rgba(255,255,255,0.55);
    font-size: .85rem;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    align-items: center;
  }
  .menu-empty-tag {
    background: var(--g06);
    color: #fff;
    border: 0;
    padding: 4px 12px;
    min-height: 28px;
    border-radius: 999px;
    font-size: .82rem;
    font-family: var(--sans);
    font-weight: 500;
    cursor: pointer;
    transition: background .15s ease, color .15s ease;
  }
  .menu-empty-tag:hover { background: var(--rojo); color: #fff; }
  .menu-empty-tag:focus-visible { outline: 2px solid var(--rojo); outline-offset: 2px; }
</style>

<script>
  import { trapFocus } from '../../lib/focus-trap';

  const overlay = document.getElementById('menu-overlay') as HTMLElement | null;
  if (overlay) {
    const body = document.getElementById('menu-body') as HTMLElement;
    const catsBar = document.getElementById('menu-cats') as HTMLElement;
    const searchInput = document.getElementById('menu-search') as HTMLInputElement;
    const closeBtn = document.getElementById('menu-close') as HTMLButtonElement;
    const noRes = document.getElementById('menu-no-res') as HTMLElement;
    const noResQ = document.getElementById('menu-empty-q') as HTMLElement;
    const srLive = document.getElementById('menu-sr-live') as HTMLElement;

    let currentQuery = '';
    let lastFocus: HTMLElement | null = null;
    let releaseTrap: (() => void) | null = null;
    let scrollSpyEnabled = true;
    let scrollSpyTimeout: number | null = null;
    const catsScroll = document.getElementById('menu-cats-scroll') as HTMLElement;

    function openMenu() {
      lastFocus = document.activeElement as HTMLElement | null;
      overlay!.hidden = false;
      requestAnimationFrame(() => {
        overlay!.classList.add('open');
        releaseTrap?.();
        releaseTrap = trapFocus(overlay!);
        const isDesktop = window.matchMedia('(min-width: 768px)').matches;
        if (isDesktop) {
          setTimeout(() => {
            searchInput.focus({ preventScroll: true });
          }, 100);
        }
      });
      overlay!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      overlay!.classList.remove('open');
      overlay!.setAttribute('aria-hidden', 'true');
      releaseTrap?.();
      releaseTrap = null;
      const restoreTo = lastFocus;
      lastFocus = null;
      setTimeout(() => {
        overlay!.hidden = true;
        restoreTo?.focus();
      }, 250);
      document.body.style.overflow = '';
    }

    function applyFilter() {
      const cards = body.querySelectorAll<HTMLElement>('.pcard');
      const groups = body.querySelectorAll<HTMLElement>('[data-cat-group]');
      const q = currentQuery;
      let anyVisible = false;

      cards.forEach(card => {
        const blob = card.dataset.search ?? '';
        const visible = !q || blob.includes(q);
        card.hidden = !visible;
        if (visible) anyVisible = true;
      });

      groups.forEach(g => {
        const visibleInGroup = g.querySelectorAll<HTMLElement>('.pcard:not([hidden])').length;
        g.hidden = visibleInGroup === 0;
      });

      noRes.hidden = anyVisible;
      if (!anyVisible && noResQ) {
        noResQ.textContent = searchInput.value.trim();
      }

      if (srLive) {
        const count = body.querySelectorAll<HTMLElement>('.pcard:not([hidden])').length;
        srLive.textContent = anyVisible
          ? `${count} resultado${count !== 1 ? 's' : ''}`
          : 'Sin resultados';
      }
    }

    function setActiveChip(catId: string) {
      catsBar.querySelectorAll<HTMLElement>('.chip').forEach(c => {
        const isTarget = c.dataset.cat === catId;
        const wasOn = c.classList.contains('on');
        c.classList.toggle('on', isTarget);
        c.setAttribute('aria-pressed', isTarget ? 'true' : 'false');
        if (isTarget && !wasOn && catsScroll.contains(c)) {
          c.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    }

    catsBar.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('.chip');
      if (!btn) return;
      const cat = btn.dataset.cat ?? 'all';
      setActiveChip(cat);
      scrollSpyEnabled = false;
      if (scrollSpyTimeout) window.clearTimeout(scrollSpyTimeout);
      if (cat === 'all') {
        body.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        const section = body.querySelector<HTMLElement>(`[data-cat-group="${cat}"]`);
        if (section) {
          const targetTop = section.offsetTop - 8;
          body.scrollTo({ top: targetTop, behavior: 'smooth' });
        }
      }
      scrollSpyTimeout = window.setTimeout(() => { scrollSpyEnabled = true; }, 650);
    });

    searchInput.addEventListener('input', () => {
      currentQuery = searchInput.value.trim().toLowerCase();
      applyFilter();
    });

    noRes.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLElement>('[data-suggest]');
      if (!btn) return;
      const suggestion = btn.dataset.suggest ?? '';
      searchInput.value = suggestion;
      currentQuery = suggestion.toLowerCase();
      applyFilter();
      searchInput.focus({ preventScroll: true });
    });

    closeBtn.addEventListener('click', closeMenu);

    body.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      const card = target.closest<HTMLElement>('.pcard');
      if (!card) return;
      const id = card.dataset.id;
      if (!id) return;
      window.dispatchEvent(new CustomEvent('temaky:open-sheet', { detail: id }));
    });

    window.addEventListener('temaky:open-menu', openMenu);
    window.addEventListener('temaky:close-menu', closeMenu);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !overlay!.hidden) closeMenu();
    });

    // Scroll-spy: highlight chip of currently visible category section
    const sections = Array.from(body.querySelectorAll<HTMLElement>('[data-cat-group]'));
    function onBodyScroll() {
      if (!scrollSpyEnabled) return;
      if (body.scrollTop < 40) {
        setActiveChip('all');
        return;
      }
      const probe = 80;
      let activeCat = sections[0]?.dataset.catGroup ?? 'all';
      for (const s of sections) {
        if (s.hidden) continue;
        const top = s.offsetTop - body.scrollTop;
        if (top - probe <= 0) {
          activeCat = s.dataset.catGroup ?? activeCat;
        } else {
          break;
        }
      }
      setActiveChip(activeCat);
    }
    let rafPending = false;
    body.addEventListener('scroll', () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        rafPending = false;
        onBodyScroll();
      });
    });
  }
</script>
