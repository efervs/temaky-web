---
import { MENU, CAT_LBL, ORDERED_CATS } from '../../data/menu';

const menuSections = ORDERED_CATS
  .map((catId) => {
    const items = MENU.filter((p) => p.cat === catId);
    if (items.length === 0) return null;
    return {
      '@type': 'MenuSection',
      name: CAT_LBL[catId] ?? catId,
      hasMenuItem: items.map((p) => {
        const item: Record<string, unknown> = {
          '@type': 'MenuItem',
          name: p.name,
          offers: {
            '@type': 'Offer',
            price: p.price.toFixed(2),
            priceCurrency: 'MXN',
          },
        };
        if (p.desc) item.description = p.desc;
        return item;
      }),
    };
  })
  .filter((s) => s !== null);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Temaky Sushi',
  image: ['https://temakysushi.mx/og.jpg'],
  '@id': 'https://temakysushi.mx',
  url: 'https://temakysushi.mx',
  telephone: '+528127474440',
  priceRange: '$$',
  servesCuisine: ['Japanese', 'Sushi'],
  acceptsReservations: 'True',
  paymentAccepted: 'Cash, Credit Card, Debit Card',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Francisco Garza Sada 2940A, Piso 2 Local 204, Plaza Villa Obispado',
    addressLocality: 'Monterrey',
    addressRegion: 'NL',
    postalCode: '64760',
    addressCountry: 'MX',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 25.6717,
    longitude: -100.3435,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '12:00',
      closes: '22:00',
    },
  ],
  sameAs: [
    'https://www.instagram.com/temakysushimty/',
    'https://maps.app.goo.gl/gZdvYsTJmWGkcaNL6',
    'https://www.rappi.com.mx/restaurantes/1923215355-temaky-sushi',
    'https://www.ubereats.com/mx/store/temaky-sushi/OqwiFbwtQea62BGRTsG1Ag',
    'https://web.didiglobal.com/mx/food/monterrey-nle/temaky-sushi/5764607773783097417/',
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.4',
    reviewCount: '604',
  },
  hasMenu: {
    '@type': 'Menu',
    name: 'Menú Temaky Sushi',
    hasMenuSection: menuSections,
  },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
