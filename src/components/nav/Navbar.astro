    <!-- Logo -->
    <a href="#top" aria-label="Temaky Sushi — inicio" class="navbar__logo">
      <img
        src="/images/logo/logo-temaky-sm.webp"
        alt="Temaky Sushi"
        width="46"
        height="44"
        fetchpriority="high"
        class="h-[60px] md:h-[80px] w-auto block [filter:drop-shadow(0_2px_8px_rgba(0,0,0,.6))]"
      />
