</nav>

<!-- Overlay backdrop -->
<div
  id="nav-overlay"
  aria-hidden="true"
  class="fixed inset-0 z-[800] opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- Mobile drawer -->
<aside
  id="nav-drawer"
  aria-label="Navegación móvil"
  class="fixed top-0 z-[900] w-[min(290px,88vw)] h-[100dvh] bg-black border-l border-white/[.07] flex flex-col justify-between pt-6 px-6 pb-[34px]"
>
  <div class="flex items-center justify-between mb-6">
    <img src="/images/logo/logo-temaky-sm.webp" alt="Temaky Sushi" width="44" height="42" class="h-[60px] w-auto px-2" />
    <button
      id="drawer-close"
      aria-label="Cerrar menú"
      class="flex items-center justify-center w-9 h-9 rounded-full bg-white/[.06] border-0 cursor-pointer text-white/70 hover:text-white hover:bg-white/[.10] transition-[background,color] duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-rojo"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  <ul class="list-none flex flex-col m-0 p-0">
    <li>
      <button data-action="open-menu" class="drawer-link w-full text-left bg-transparent border-0 font-[inherit] cursor-pointer">
        Ver Menú
      </button>
    </li>
    <li><a href="/carta.pdf" target="_blank" rel="noopener" class="drawer-link">Carta (PDF)</a></li>
    <li><a href="#reserva" class="drawer-link">Reserva</a></li>
    <li><a href="#ubic" class="drawer-link">Ubicación</a></li>
    <li>
      <a
        href="https://www.instagram.com/temakysushimty/"
        target="_blank"
        rel="noopener"
        class="drawer-link"
      >Instagram</a>
    </li>
  </ul>

  <div class="flex flex-col gap-[9px]">
    <a
      href="https://wa.me/5218136080040?text=Hola!%20Quiero%20hacer%20un%20pedido%20%F0%9F%8D%A3"
      target="_blank"
      rel="noopener"
      class="block text-center bg-rojo text-white no-underline py-[13px] rounded-[8px] font-semibold transition-[background] duration-200 hover:bg-rojo-dark"
    >Pedir por WhatsApp</a>
    <p class="text-[.76rem] text-white/30 text-center mt-2">+52 1 81 3608 0040</p>
  </div>
</aside>

<style>
  /* Overlay backdrop */
  #nav-overlay {
    background: rgba(0, 0, 0, 0.92);
  }

  /* Scroll-activated solid state */
  #site-nav.solid {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* "Menú" — link protagonista */
  .nav-menu-link {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--display);
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    padding: 3px 0;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    line-height: 1;
  }
  .nav-menu-link:hover { border-bottom-color: #B8102E; }
  .nav-menu-link:focus-visible { outline: 2px solid #B8102E; outline-offset: 2px; }

  /* Desktop nav links (secundarios) */
  .nav-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.84rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    padding: 3px 0;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .nav-link:hover { color: #fff; border-bottom-color: #B8102E; }
  .nav-link:focus-visible { outline: 2px solid #B8102E; outline-offset: 2px; }

  /* Instagram icon link */
  .nav-ig {
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.2s;
  }
  .nav-ig svg { width: 20px; height: 20px; }
  .nav-ig:hover { color: #fff; }
  .nav-ig:focus-visible { outline: 2px solid #B8102E; outline-offset: 2px; border-radius: 5px; }

  /* Drawer links */
  .drawer-link {
    display: block;
    font-size: 1.05rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.70);
    text-decoration: none;
    padding: 13px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  .drawer-link:hover { color: #fff; }
  .drawer-link:focus-visible { outline: 2px solid #B8102E; outline-offset: 2px; }

  /* Drawer and overlay open states (toggled by JS) */
  #nav-drawer {
    right: -110%;
    transition: right 0.35s ease;
  }
  #nav-drawer.open { right: 0; }

  #nav-overlay.on {
    opacity: 1;
    pointer-events: auto;
  }

  /* Hamburger → X */
  #nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  #nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Hide top logo while drawer is open */
  .navbar__logo {
    transition: opacity 0.25s;
  }
  #site-nav.drawer-open .navbar__logo {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  import { trapFocus } from '../../lib/focus-trap';

  const siteNav = document.getElementById('site-nav') as HTMLElement;
  const hamburger = document.getElementById('nav-hamburger') as HTMLButtonElement;
  const drawerClose = document.getElementById('drawer-close') as HTMLButtonElement;
  const drawer = document.getElementById('nav-drawer') as HTMLElement;
  const overlay = document.getElementById('nav-overlay') as HTMLElement;

  let releaseTrap: (() => void) | null = null;

  // Scroll → solid class (deferred to rAF to avoid forced-reflow on initial paint)
  function updateSolid() {
    siteNav.classList.toggle('solid', window.scrollY > 80);
  }
  window.addEventListener('scroll', updateSolid, { passive: true });
  requestAnimationFrame(updateSolid);

  // Drawer helpers
  function openDrawer() {
    hamburger.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    drawer.classList.add('open');
    overlay.classList.add('on');
    siteNav.classList.add('drawer-open');
    document.body.style.overflow = 'hidden';
    releaseTrap?.();
    releaseTrap = trapFocus(drawer);
  }

  function closeDrawer() {
    hamburger.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    drawer.classList.remove('open');
    overlay.classList.remove('on');
    siteNav.classList.remove('drawer-open');
    document.body.style.overflow = '';
    releaseTrap?.();
    releaseTrap = null;
    hamburger.focus();
  }

  hamburger.addEventListener('click', () => {
    drawer.classList.contains('open') ? closeDrawer() : openDrawer();
  });
  drawerClose.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);

  // Close drawer when navigating via anchor links inside it
  drawer.querySelectorAll('a[href]').forEach(link => link.addEventListener('click', closeDrawer));

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
  });

  // Menu overlay trigger (implemented in F3-4 — dispatches custom event)
  document.querySelectorAll('[data-action="open-menu"]').forEach(el => {
    el.addEventListener('click', () => {
      closeDrawer();
      window.dispatchEvent(new CustomEvent('temaky:open-menu'));
    });
  });
</script>
