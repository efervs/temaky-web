    <!-- Desktop nav links -->
    <ul class="hidden md:flex gap-6 list-none items-center m-0 p-0">
      <li>
        <button data-action="open-menu" class="nav-menu-link" aria-label="Ver el menú">
          Menú
        </button>
      </li>
      <li><a href="/carta.pdf" target="_blank" rel="noopener" class="nav-link">Carta (PDF)</a></li>
      <li><a href="#reserva" class="nav-link">Reserva</a></li>
      <li><a href="#ubic" class="nav-link">Ubicación</a></li>
      <li>
        <a
          href="https://www.instagram.com/temakysushimty/"
          target="_blank"
          rel="noopener"
          class="nav-ig"
          aria-label="Instagram @temakysushimty"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <rect x="2.2" y="2.2" width="19.6" height="19.6" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </li>
    </ul>

    <!-- Right side -->
    <div class="flex items-center gap-2">
      <a
        href="https://wa.me/5218136080040?text=Hola!%20Quiero%20hacer%20un%20pedido%20%F0%9F%8D%A3"
        target="_blank"
        rel="noopener"
        class="hidden md:inline-flex items-center justify-center gap-2 bg-rojo text-white no-underline px-5 py-2.5 rounded-[8px] text-[.82rem] font-semibold tracking-[.02em] leading-none min-h-[40px] transition-[background,transform] duration-200 hover:bg-rojo-dark hover:-translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-rojo active:translate-y-0 cursor-pointer"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.241-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885" /></svg>
        Pedir
      </a>

      <!-- Hamburger button (mobile) -->
      <button
        id="nav-hamburger"
        class="flex md:hidden flex-col gap-[5px] bg-transparent border-0 p-1 cursor-pointer"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <span class="block w-6 h-[2px] bg-white rounded-[2px] transition-transform duration-300 origin-center"></span>
        <span class="block w-6 h-[2px] bg-white rounded-[2px] transition-[transform,opacity] duration-300"></span>
        <span class="block w-6 h-[2px] bg-white rounded-[2px] transition-transform duration-300 origin-center"></span>
