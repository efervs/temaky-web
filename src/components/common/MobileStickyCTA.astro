---
---
<div
  id="mobile-sticky-cta"
  class="msc"
  data-visible="false"
  aria-hidden="true"
>
  <div class="msc-left">
    <span class="msc-eyebrow">Combo Clásico</span>
    <span class="msc-price">$139</span>
  </div>
  <button
    type="button"
    class="msc-btn"
    data-action="open-sheet"
    data-sheet-id="combo-clasico"
    aria-label="Pedir Combo Clásico de 139 pesos"
  >
    Pedir <span class="msc-arrow" aria-hidden="true">→</span>
  </button>
</div>

<style>
  .msc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-mob-cta);
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: var(--rojo);
    color: var(--blanco);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.45);
    transform: translateY(100%);
    transition: transform 220ms ease-out;
    will-change: transform;
  }

  @media (max-width: 767px) {
    .msc { display: flex; }
  }

  .msc[data-visible="true"] { transform: translateY(0); }

  .msc-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .msc-eyebrow {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.1;
  }

  .msc-price {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--blanco);
  }

  .msc-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 20px;
    background: var(--blanco);
    color: var(--rojo);
    border: 0;
    border-radius: 10px;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    min-height: 44px;
    transition: background 180ms ease, transform 180ms ease;
  }
  .msc-btn:hover { background: #f5f5f5; }
  .msc-btn:active { transform: scale(0.97); }
  .msc-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  .msc-arrow {
    font-size: 1.1rem;
    font-weight: 400;
    transition: transform 180ms ease;
  }
  .msc-btn:hover .msc-arrow { transform: translateX(3px); }
</style>

<script>
  const bar = document.getElementById('mobile-sticky-cta');
  if (bar) {
    let ticking = false;
    const update = () => {
      const visible = window.scrollY > 300;
      bar.dataset.visible = visible ? 'true' : 'false';
      bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
    update();

    const btn = bar.querySelector<HTMLButtonElement>('[data-action="open-sheet"]');
    btn?.addEventListener('click', () => {
      const id = btn.dataset.sheetId ?? '';
      window.dispatchEvent(new CustomEvent('temaky:open-sheet', { detail: id }));
    });
  }
</script>
